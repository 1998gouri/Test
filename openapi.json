{
  "openapi": "3.1.0",
  "info": {
    "title": "Urja Meter API",
    "version": "1.0.0",
    "description": "Read-only normalized facade for meter search, details, energy readings and distribution transformers."
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Health",
        "responses": {
          "200": {
            "description": "Service health and upstream session configuration status."
          }
        }
      }
    },
    "/api/v1/meters": {
      "get": {
        "tags": [
          "meters"
        ],
        "summary": "Search meters",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "default": ""
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Meter search response and pagination metadata."
          },
          "502": {
            "description": "Upstream portal error."
          }
        }
      }
    },
    "/api/v1/meters/{meter_id}": {
      "get": {
        "tags": [
          "meters"
        ],
        "summary": "Meter details, hierarchy and coordinates",
        "parameters": [
          {
            "name": "meter_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Decoded meter details."
          },
          "404": {
            "description": "Meter not found."
          },
          "502": {
            "description": "Upstream portal error."
          }
        }
      }
    },
    "/api/v1/meters/{meter_id}/energy": {
      "get": {
        "tags": [
          "energy"
        ],
        "summary": "Energy readings",
        "parameters": [
          {
            "name": "meter_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Energy response with upstream values preserved."
          },
          "502": {
            "description": "Upstream portal error."
          }
        }
      }
    },
    "/api/v1/transformers": {
      "get": {
        "tags": [
          "network"
        ],
        "summary": "List distribution transformers",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Transformer list and pagination metadata."
          },
          "502": {
            "description": "Upstream portal error."
          }
        }
      }
    }
  }
}
